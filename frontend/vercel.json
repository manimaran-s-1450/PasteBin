{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/create", "dest": "/create.html" },
    { "src": "/history", "dest": "/history.html" },
    { "src": "/view", "dest": "/view.html" },
    { "src": "/edit", "dest": "/edit.html" },
    { "src": "/docs", "dest": "/docs.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
